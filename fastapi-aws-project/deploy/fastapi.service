[Unit]
Description=Servicio FastAPI Uvicorn
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fastapi-aws-project
EnvironmentFile=/home/ubuntu/fastapi-aws-project/.env
ExecStart=/home/ubuntu/fastapi-aws-project/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

